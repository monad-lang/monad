# Build output. The Rust workspace lives in rust/, so cargo's output is
# `rust/target/`; `target-monad/` is monad's (.monad/config.toml). `/target`
# is kept because it is still the monad default for a project with no config,
# and an edit here could restore it; dropping it would fail quietly.
/target
/rust/target
/target-monad
# Cargo output from before the rust/ move (2026-10-30); kept ignored so an
# existing checkout does not surface it as untracked after pulling.
/target-rust
history.txt

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Docs build output (mdBook -> docs/site/static/docs, Zola -> docs/public)
docs/public
docs/site/public
docs/site/static/docs
# `scripts/sync-install.sh` generates this from the canonical
# `scripts/monadup` for Zola to serve at /install; it is build output.
docs/site/static/install

# `scripts/build-try.sh` stages the /try wasm, the generated host and the
# served prelude sources into the Zola static tree; the page shell,
# stylesheet, worker and source-framing scripts beside them are source
# (committed).
docs/site/static/try/try_engine.wasm
docs/site/static/try/try_ui.wasm
docs/site/static/try/web.js
docs/site/static/try/web_runtime.js
docs/site/static/try/float_format.js
# The prelude the page fetches at run time (the engine embeds no copy).
docs/site/static/try/sources.json
docs/site/static/try/sources/

# The web profile's JS glue: generated by `scripts/gen-web-js.sh` from
# `examples/gen_web_js.mo`, never edited by hand (the /try copy above is
# staged from the same generator).
wasm/web/web.js

# Nightly release artifacts (scripts/nightly-release.sh). Build output: the
# release step uploads them from dist/, which git need not track.
dist/

# `nix build` symlinks. Root-anchored, because `result` is an ordinary name
# anywhere else in the tree. This matters for more than tidiness: `src = ./.`
# copies the whole tree into the store, so an untracked `result` symlink lands
# in the source of every derivation that builds it.
/result
/result-*

# Plans directory for implementation planning
plans

# Weaver's project-local settings (motes/weaver/src/settings.mo reads
# .weaver/config.toml from the working directory); a per-project config
# is user state, never source.
.weaver

# Agents
.opencode
.ori
.vibe

# Python bytecode from the one-off migration scripts in scripts/
__pycache__/
*.pyc
