/// The golden modules: small, hand-built `MlirModule` values whose rendered
/// text is checked in as `.mlir` under `fixtures/mlir/goldens/`.
///
/// ## Why the fixtures are VALUES, not text
///
/// The point of a golden here is not "does this file parse" -- Phase 0's
/// `fixtures/mlir/saxpy.mlir` already proves MLIR's own parser accepts
/// hand-written text. The point is **`print_module` renders the model the
/// way `mlir-opt` would**, and that can only be tested by building the model
/// in Monad and comparing the result to text. So these are constructors, and
/// the `.mlir` files beside them are the EXPECTED output, regenerated only
/// when a deliberate change is made.
///
/// ## Why three modules and not one
///
/// Each isolates a shape a single big module would hide:
///
/// * `scalar_saxpy` -- the Phase 0 kernel, rebuilt through the model: two
///   `memref` arguments with `llvm.noalias`, an `i32` bit-pattern scalar, an
///   `scf.for` with a `memref.store`, and a bare `return`. If this matches
///   `fixtures/mlir/saxpy.mlir`'s `@saxpy` in structure, the model can
///   express everything Phase 0 hand-wrote, which is Phase 2's precondition.
/// * `loop_carried` -- an `scf.for` with `iter_args` and a `scf.yield`: the
///   reduction shape. Isolated because `iter_args` is the single most
///   error-prone header in this backend (two parallel name lists plus a
///   result list), and it is invisible in a module that only stores.
/// * `branching` -- a `scf.if` with both arms, so the printer's region
///   nesting and its `else` handling are exercised. A module with only
///   `scf.for` never nests two blocks under one op.
///
/// `loc(...)` appears in every one: it is the only channel a diagnostic has
/// back to Monad source, so a golden pair that omitted it would not be
/// testing the thing the plan calls its cheapest quality win.
///
/// ## Why the values carry no `Result`
///
/// A module is either well-formed as a value or unbuildable: the model has
/// no place to put a dangling value reference, and MLIR's verifier is the
/// judge of the rest (`scripts/check-mlir-goldens.sh` runs `--verify-each`).
/// A `Result` here would mean the same modules appear TWICE -- once as a
/// value, once as an error -- which is a shape the type system would then
/// let a caller ignore.

use lib::ir {
    MlirBlock, MlirFunction, MlirModule, MlirOp, MlirParam, MlirType, MlirValue,
    mlir_loc,
}
// Names imported explicitly, one per dialect: a bare `use lib::dialect::arith`
// imports NOTHING in this compiler, and a qualified term reference
// (`arith.constant_index`) does not resolve self-hosted -- see AGENTS.md. So
// every constructor this file calls is named here, which also makes the file
// the readable index of which ops the goldens use.
use lib::dialect::arith {
    addf, bitcast, cmpi, constant_f32, constant_f64, constant_i64,
    constant_index, extf, index_cast, mulf, sitofp,
}
use lib::dialect::func {return_, return_void}
use lib::dialect::memref {load, store}
use lib::dialect::scf {for_, for_iter, if_result, yield}

/// The source location every golden op carries. One constant rather than a
/// literal at each site, so the golden files are regenerated by changing one
/// line -- and so a reader can see at a glance that `loc(...)` is present on
/// purpose rather than by accident.
def golden_loc : String := mlir_loc "kernels.mo" 12 5

/// The index constants every loop needs. Named rather than built inline at
/// each use, because `%c0`/`%c1`/`%c16` appear in three modules and a typo
/// in one would show up as an unbound value in a verifier message naming
/// the generated line.
def c0 : String := "c0"
def c1 : String := "c1"
def c16 : String := "c16"

def const_zero : MlirOp := constant_index c0 0 golden_loc
def const_one : MlirOp := constant_index c1 1 golden_loc
def const_sixteen : MlirOp := constant_index c16 16 golden_loc

/// The three index constants, in order -- the prologue of every loop here.
def index_constants : List MlirOp := [const_zero, const_one, const_sixteen]

// ─── 1. the Phase 0 kernel, rebuilt through the model ────────────────

/// `dst[i] = a * (f32)i + 1.0`, `a` arriving as an `i32` bit pattern.
///
/// Every shape here is Phase 0's hand-written `@saxpy`
/// (`fixtures/mlir/saxpy.mlir`), and matching it is the claim: if the model
/// cannot express the fixture that the ABI proof was measured against, the
/// model is not ready for Phase 2.
def scalar_saxpy_body : MlirBlock :=
    MlirBlock.entry "" (List.append index_constants [
        // The boundary is integral: an `F32` crosses a C ABI as its `i32`
        // bit pattern (`emit_extern_param_cast` does `trunc` + `bitcast`),
        // so the kernel takes the bits and bitcasts back.
        bitcast "a" (MlirValue.named "a_bits") MlirType.i32 MlirType.f32 golden_loc,
        constant_f32 "one" "1.0" golden_loc,
        for_ "i" (MlirValue.named c0) (MlirValue.named c16) (MlirValue.named c1)
            [scf_loop_body] golden_loc,
        return_void golden_loc,
    ])

/// The loop's body: no block header, because `scf.for` binds the induction
/// variable in its own header (see `dialect/scf.mo`'s file comment).
def scf_loop_body : MlirBlock :=
    MlirBlock.entry "" [
        index_cast "i64" (MlirValue.named "i") MlirType.i64 golden_loc,
        sitofp "x" (MlirValue.named "i64") MlirType.i64 MlirType.f32 golden_loc,
        mulf "t" (MlirValue.named "a") (MlirValue.named "x") MlirType.f32 golden_loc,
        addf "r" (MlirValue.named "t") (MlirValue.named "one") MlirType.f32 golden_loc,
        store (MlirValue.named "r") (MlirValue.named "dst")
            (MlirType.memref_1d 16 MlirType.f32) [MlirValue.named "i"] golden_loc,
    ]

def scalar_saxpy : MlirFunction :=
    { name := "saxpy",
        params := [
            MlirParam.restrict "dst" (MlirType.memref_1d 16 MlirType.f32),
            MlirParam.plain "a_bits" MlirType.i32,
        ],
        results := List.empty,
        body := scalar_saxpy_body,
        loc := golden_loc,
        visibility := "" }

// ─── 2. a loop-carried reduction ─────────────────────────────────────

/// `sum(v[i] for i in 0..16)` as an `f64` -- `iter_args` plus `scf.yield`.
///
/// `iter_args` is the op header with the most moving parts (two parallel
/// name lists and a result list), so it gets its own module rather than
/// being a second function in the first.
def loop_carried_body : MlirBlock :=
    MlirBlock.entry "" (List.append index_constants [
        constant_f64 "zero" "0.0" golden_loc,
        for_iter "acc" "i" (MlirValue.named c0) (MlirValue.named c16) (MlirValue.named c1)
            ["s"] [MlirValue.named "zero"] [MlirType.f64] [reduce_body] golden_loc,
        return_ (MlirValue.named "acc") MlirType.f64 golden_loc,
    ])

/// `s + (f64)v[i]`, yielded back.
///
/// BOTH the induction variable and the loop-carried value are referenced by
/// their SOURCE NAMES (`%i`, `%s`), not as `%argN`. That is a measured
/// correction, not a preference: `scf.for` binds its induction variable in
/// the op's own header (`scf.for %i = ...`), and the body region has NO
/// block header at all -- so there is no block-argument index to address.
/// A `%arg0` here is `use of undeclared SSA value name` from `mlir-opt`
/// 21.1.8. `MlirValue.arg_` is for a block that really does print
/// `^bb0(%arg0: T):`, which nothing in this backend emits today.
def reduce_body : MlirBlock :=
    MlirBlock.entry "" [
        load "vi" (MlirValue.named "v") (MlirType.memref_1d 16 MlirType.f32)
            [MlirValue.named "i"] golden_loc,
        extf "vid" (MlirValue.named "vi") MlirType.f32 MlirType.f64 golden_loc,
        addf "next" (MlirValue.named "s") (MlirValue.named "vid") MlirType.f64 golden_loc,
        yield [MlirValue.named "next"] [MlirType.f64] golden_loc,
    ]

def loop_carried : MlirFunction :=
    { name := "total",
        params := [MlirParam.restrict "v" (MlirType.memref_1d 16 MlirType.f32)],
        results := [MlirType.f64],
        body := loop_carried_body,
        loc := golden_loc,
        visibility := "" }

// ─── 3. a branch, so the printer nests two blocks ────────────────────

/// `if n > 0 then 1.0 else 0.0` as an `scf.if` with a result -- the shape
/// where the printer has to emit `} else {` on ONE LINE, and the one where
/// a mis-placed `else` would be invisible until `mlir-opt` rejected it.
/// The else arm is an OP LIST (`if_result`'s signature), because MLIR
/// introduces it with a keyword rather than with a block label.
def branching_body : MlirBlock :=
    MlirBlock.entry "" [
        constant_f64 "zero" "0.0" golden_loc,
        constant_f64 "one" "1.0" golden_loc,
        constant_i64 "n_max" 0 golden_loc,
        cmpi "pos" "sgt" (MlirValue.named "n") (MlirValue.named "n_max") MlirType.i64 golden_loc,
        if_result "r" (MlirValue.named "pos") [MlirType.f64]
            [then_arm] [yield [MlirValue.named "zero"] [MlirType.f64] golden_loc] golden_loc,
        return_ (MlirValue.named "r") MlirType.f64 golden_loc,
    ]

/// The `then` arm: yield `1.0`.
def then_arm : MlirBlock :=
    MlirBlock.entry "" [yield [MlirValue.named "one"] [MlirType.f64] golden_loc]

def branching : MlirFunction :=
    { name := "indicator",
        params := [MlirParam.plain "n" MlirType.i64],
        results := [MlirType.f64],
        body := branching_body,
        loc := golden_loc,
        visibility := "" }

// ─── the registry ────────────────────────────────────────────────────

/// The goldens by name, in the order a reader should read them: a plain
/// loop, a reduction, a branch. Each name is also its `.mlir` filename under
/// `fixtures/mlir/goldens/`.
pub def golden_modules : List (Pair String MlirModule) := [
    Pair.pair "scalar_saxpy" (MlirModule.of_functions [scalar_saxpy]),
    Pair.pair "loop_carried" (MlirModule.of_functions [loop_carried]),
    Pair.pair "branching" (MlirModule.of_functions [branching]),
]

/// The names, in registry order.
pub def golden_names : List String := List.map golden_pair_name golden_modules

/// `List.map` wants a one-argument function, which a pattern inside a def
/// cannot be, so the projection is its own def.
def golden_pair_name (p : Pair String MlirModule) : String := match p {
    Pair.pair n _ => n,
}

/// `names`, one per line, newline-terminated -- what `--list` prints.
///
/// Takes the NAME list rather than the registry so its signature says what
/// it does: the caller that has names (`golden_names`) should not have to
/// carry the modules to get them rendered. Newline-terminated so a reader
/// sees one name per line with no trailing blank line.
pub def show_names (names : List String) : String :=
    String.concat_list (List.reverse (names_go names List.empty))

def names_go (names : List String) (acc : List String) : List String :=
    match names {
        List.empty => acc,
        List.cons n rest => names_go rest (List.cons (String.concat n "\n") acc),
    }

/// The module registered under `name`, or `Option.none` so a caller can
/// produce a diagnostic naming the golden rather than rendering an empty
/// module and exiting 0.
pub def golden_module (name : String) : Option MlirModule :=
    lookup_module golden_modules name

#[partial]
def lookup_module (modules : List (Pair String MlirModule)) (name : String) : Option MlirModule :=
    match modules {
        List.empty => Option.none,
        List.cons p rest =>
            if String.beq (golden_pair_name p) name
            then Option.some (golden_pair_value p)
            else lookup_module rest name,
    }

def golden_pair_value (p : Pair String MlirModule) : MlirModule := match p {
    Pair.pair _ m => m,
}
