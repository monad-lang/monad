/// jsgen tests: escaping, identifier validation, and deterministic rendering.

use lib::js {
  Js.Expr, Js.Module, Js.Stmt, Js.render_expr, Js.render_module,
  Js.render_stmt, Js.string_literal, Js.valid_ident,
}

#[test]
def test_string_literal_plain : Bool :=
  String.beq (Js.string_literal "hi") "\"hi\""

#[test]
def test_string_literal_quote_and_backslash : Bool :=
  String.beq (Js.string_literal "\"\\") "\"\\\"\\\\\""

#[test]
def test_string_literal_newline : Bool :=
  String.beq (Js.string_literal "a\nb") "\"a\\nb\""

#[test]
def test_string_literal_lt_is_escaped : Bool :=
  String.beq (Js.string_literal "<script>") "\"\\u003cscript>\""

#[test]
def test_valid_ident_accepts : Bool :=
  Bool.and (Js.valid_ident "foo") (Bool.and (Js.valid_ident "_x1") (Js.valid_ident "A"))

#[test]
def test_valid_ident_rejects : Bool :=
  Bool.not (Bool.or (Js.valid_ident "") (Bool.or (Js.valid_ident "1x") (Js.valid_ident "a-b")))

#[test]
def test_render_int : Bool :=
  String.beq (Js.render_expr (Js.Expr.int 42)) "42"

#[test]
def test_render_member : Bool :=
  String.beq (Js.render_expr (Js.Expr.member (Js.Expr.ident "x") "y")) "x.y"

#[test]
def test_render_call : Bool :=
  String.beq
    (Js.render_expr (Js.Expr.call (Js.Expr.ident "f") (List.cons (Js.Expr.string "a") List.empty)))
    "f(\"a\")"

#[test]
def test_render_object : Bool :=
  String.beq
    (Js.render_expr (Js.Expr.object (List.cons (Pair.pair "k" (Js.Expr.int 1)) List.empty)))
    "{\"k\": 1}"

#[test]
def test_render_let : Bool :=
  String.beq (Js.render_stmt 0 (Js.Stmt.let_bind "x" (Js.Expr.int 1))) "let x = 1;\n"

#[test]
def test_render_return : Bool :=
  String.beq
    (Js.render_stmt 0 (Js.Stmt.ret (Option.some (Js.Expr.int 1))))
    "return 1;\n"

#[test]
def test_render_module_header_and_body : Bool :=
  let m : Js.Module :=
    { header := List.cons "generated by jsgen" List.empty,
      imports := List.empty,
      body := List.cons (Js.Stmt.expr (Js.Expr.call (Js.Expr.ident "f") List.empty)) List.empty } in
  String.beq (Js.render_module m) "// generated by jsgen\n\nf();\n"

// ── UTF-8 and the remaining constructors ───────────────────────────────

#[test]
def test_string_literal_utf8 : Bool :=
  String.beq (Js.string_literal "café") "\"café\""

#[test]
def test_member_invalid_field_is_bracketed : Bool :=
  String.beq
    (Js.render_expr (Js.Expr.member (Js.Expr.ident "x") "y; alert(1)"))
    "x[\"y; alert(1)\"]"

#[test]
def test_render_array : Bool :=
  String.beq
    (Js.render_expr (Js.Expr.array [Js.Expr.int 1, Js.Expr.int 2]))
    "[1, 2]"

#[test]
def test_render_bool_null_undefined : Bool :=
  Bool.and (String.beq (Js.render_expr (Js.Expr.bool true)) "true")
    (Bool.and (String.beq (Js.render_expr Js.Expr.null) "null")
      (String.beq (Js.render_expr Js.Expr.undefined) "undefined"))

#[test]
def test_render_assign : Bool :=
  String.beq (Js.render_stmt 0 (Js.Stmt.assign "x" (Js.Expr.int 1))) "x = 1;\n"

#[test]
def test_render_throw : Bool :=
  String.beq (Js.render_stmt 0 (Js.Stmt.throw_ (Js.Expr.string "bad"))) "throw \"bad\";\n"

#[test]
def test_render_raw_is_verbatim : Bool :=
  String.beq (Js.render_expr (Js.Expr.raw "trusted()")) "trusted()"

#[test]
def test_render_arrow : Bool :=
  String.beq
    (Js.render_expr
      (Js.Expr.arrow ["x"] [Js.Stmt.ret (Option.some (Js.Expr.ident "x"))]))
    "(x) => {\n  return x;\n}"
