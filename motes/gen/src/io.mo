// Generator plumbing: `--flag value` arguments, the AUTO-GENERATED banner,
// and write-or-check output.

use std::io {IO.println, IO.read_file, IO.write_file}
use std::path {Path}
use std::stream {StreamError}

/// The value following `flag` in an argv list, or none.
pub def Gen.arg (args : List String) (flag : String) : Option String :=
    arg_go args flag

#[partial]
def arg_go (args : List String) (flag : String) : Option String :=
    match args {
        List.empty => Option.none,
        List.cons hd tl =>
            if String.beq hd flag
            then head_of tl
            else arg_go tl flag,
    }

def head_of (args : List String) : Option String :=
    match args {
        List.cons hd _ => Option.some hd,
        List.empty => Option.none,
    }

/// The AUTO-GENERATED banner: a line naming the generating tool, then each
/// note as one comment line -- the input URLs and digests, and whatever
/// prose the file's readers need.
pub def Gen.banner (tool : String) (notes : List String) : String :=
    String.concat "// AUTO-GENERATED by "
        (String.concat tool (String.concat " -- do not edit.\n"
            (String.concat "//\n" (String.concat (note_lines notes) "//\n"))))

#[partial]
def note_lines (notes : List String) : String :=
    match notes {
        List.empty => "",
        List.cons hd tl => String.concat (note_line hd) (note_lines tl),
    }

/// A blank note is a bare `//` -- the old spelling left a trailing space.
def note_line (note : String) : String :=
    if String.is_empty note
    then "//\n"
    else String.concat "// " (String.concat note "\n")

/// Write `text` to `out`, or with `check` only verify the file on disk
/// already says exactly that. Returns the process exit code: 1 when a
/// `check` run finds a difference.
pub def Gen.write_or_check (check : Bool) (out : String) (text : String) : IO I64 :=
    if check then check_existing out text else write_new out text

def write_new (out : String) (text : String) : IO I64 := do {
    let written <- IO.write_file (Path.path out) text;
    let _printed <- IO.println (write_report written out);
    return 0
}

#[partial]
def write_report (written : Result StreamError Unit) (out : String) : String :=
    match written {
        Result.ok _ => String.concat "wrote " out,
        Result.err e => String.concat "failed to write " (String.concat out (String.concat ": " e.message)),
    }

def check_existing (out : String) (text : String) : IO I64 := do {
    let existing <- IO.read_file (Path.path out);
    let same := existing_is existing text;
    let _printed <- IO.println (check_report same existing out);
    return (code_of same)
}

def code_of (same : Bool) : I64 := if same then 0 else 1

#[partial]
def existing_is (existing : Result StreamError String) (text : String) : Bool :=
    match existing {
        Result.ok on_disk => String.beq on_disk text,
        Result.err _ => false,
    }

#[partial]
def check_report (same : Bool) (existing : Result StreamError String) (out : String) : String :=
    match existing {
        Result.err e => String.concat out (String.concat " is not readable: " e.message),
        Result.ok _ =>
            if same
            then String.concat out " is up to date"
            else String.concat out " differs from a fresh generation",
    }
