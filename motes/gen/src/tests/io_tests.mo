// `Gen.arg` reads a value-taking flag; `Gen.flag` reads a bare switch, which
// is normally the LAST argument and so has nothing after it.

use gen::io {Gen.arg, Gen.banner, Gen.flag}

#[test]
def test_arg_takes_the_following_value : Bool :=
    match Gen.arg ["--out", "/tmp/x.mo", "--check"] "--out" {
        Option.some value => String.beq value "/tmp/x.mo",
        Option.none => false,
    }

#[test]
def test_arg_absent : Bool :=
    match Gen.arg ["--out", "/tmp/x.mo"] "--entities" {
        Option.some _ => false,
        Option.none => true,
    }

#[test]
def test_arg_needs_a_value_after_the_flag : Bool :=
    match Gen.arg ["--check"] "--check" {
        Option.some _ => false,
        Option.none => true,
    }

#[test]
def test_flag_reads_a_trailing_switch : Bool :=
    Gen.flag ["--out", "/tmp/x.mo", "--check"] "--check"

#[test]
def test_flag_absent : Bool :=
    Bool.not (Gen.flag ["--out", "/tmp/x.mo"] "--check")

#[test]
def test_flag_absent_from_empty_args : Bool :=
    Bool.not (Gen.flag [] "--check")

#[test]
def test_banner_names_the_tool_and_notes : Bool :=
    let text := Gen.banner "tool.mo" ["Source: x", "", "second"] in
    String.beq text
        "// AUTO-GENERATED by tool.mo -- do not edit.\n//\n// Source: x\n//\n// second\n//\n"
