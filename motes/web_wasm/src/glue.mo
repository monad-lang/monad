/// Generate the browser loader from `WebAbi`.
///
/// The generated module is deliberately small: it builds the import object
/// from the ABI (so the names cannot drift from the C/extern declarations),
/// then exposes `start`, which instantiates the module and calls
/// `oak_mount`. The bodies behind each import live in
/// `wasm/web/web_runtime.js`, imported here as `host`; that file is
/// hand-reviewed and is the only place DOM/fetch behavior is written.
///
/// Every name is rendered through `jsgen`; the two fixed JS snippets
/// (`start` and the re-export) are `Js.Expr.raw` literals and are visibly
/// marked below.

use jsgen::js {Js.Expr, Js.Module, Js.Stmt, Js.render_module, Js.valid_ident}
use lib::web_abi {WebAbi, WebImport}

/// The loader body.
///
/// `set_root` tells the runtime which selector `dom_root` means (the DOM
/// side owns the selector string; no Monad string crosses the export ABI),
/// `bind` hands the runtime its instance so DOM listeners can call
/// `oak_dispatch_event`, and `start_ticks` drives `oak_tick` from
/// `requestAnimationFrame`. The snippet is a `Js.Expr.raw` literal --
/// visibly the one hand-written piece of the generated file, which is why
/// `Glue.loader`'s goldens pin it.
def Glue.start_snippet : String :=
  "async (url, selector) => { host.set_root(selector); let mod; try { mod = await WebAssembly.compileStreaming(fetch(url)); } catch (e) { mod = await WebAssembly.compile(await (await fetch(url)).arrayBuffer()); } const instance = await WebAssembly.instantiate(mod, imports); host.bind(instance); if (instance.exports.oak_mount) instance.exports.oak_mount(); host.start_ticks(instance); return instance; }"

pub def Glue.loader (abi : WebAbi) : String :=
  Js.render_module (Glue.module abi)

def Glue.module (abi : WebAbi) : Js.Module :=
  let header : List String :=
    ["generated by web_wasm from WebAbi -- do not edit"] in
  let imports : List Js.Stmt := [
    Js.Stmt.expr (Js.Expr.raw "import { host } from \"./web_runtime.js\"")
  ] in
  let body : List Js.Stmt := [
    Js.Stmt.let_bind "imports"
      (Js.Expr.object (Glue.module_fields (Glue.module_names abi.imports List.empty) abi.imports)),
    Js.Stmt.expr (Js.Expr.raw "export { imports }"),
    Js.Stmt.let_bind "start" (Js.Expr.raw Glue.start_snippet),
    Js.Stmt.expr (Js.Expr.raw "export { start }")
  ] in
  let m : Js.Module := { header := header, imports := imports, body := body } in
  m

/// Every distinct `module` in the ABI, in first-encounter order.
#[terminating]
def Glue.module_names (imports : List WebImport) (acc : List String) : List String :=
  match imports {
    List.empty => List.reverse acc,
    List.cons imp rest =>
      if Glue.name_in imp.module acc
      then Glue.module_names rest acc
      else Glue.module_names rest (List.cons imp.module acc)
  }

#[terminating]
def Glue.name_in (name : String) (names : List String) : Bool :=
  match names {
    List.empty => false,
    List.cons n rest => if String.beq n name then true else Glue.name_in name rest
  }

/// One `{ "<module>": { <imports> } }` entry per module. The import object
/// must carry every `WebImport.module`; grouping them all under `"monad"`
/// would make `instantiateStreaming` fail with a missing-import `LinkError`.
#[terminating]
def Glue.module_fields (names : List String) (imports : List WebImport) : List (Pair String Js.Expr) :=
  match names {
    List.empty => List.empty,
    List.cons name rest =>
      List.cons (Pair.pair name (Js.Expr.object (Glue.import_fields_for name imports)))
        (Glue.module_fields rest imports)
  }

#[terminating]
def Glue.import_fields_for (module : String) (imports : List WebImport) : List (Pair String Js.Expr) :=
  match imports {
    List.empty => List.empty,
    List.cons imp rest =>
      if String.beq imp.module module
      then List.cons (Pair.pair imp.name (Glue.import_expr imp.name))
        (Glue.import_fields_for module rest)
      else Glue.import_fields_for module rest
  }

def Glue.import_expr (name : String) : Js.Expr :=
  if Js.valid_ident name
  then Js.Expr.raw (String.concat_list ["(...args) => host.", name, "(...args)"])
  else Js.Expr.raw "() => { throw new Error(\"invalid import name\"); }"
