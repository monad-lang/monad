/// Glue generator tests. These are pure: they never call a web extern, so
/// they run on the Rust host and on every target.

use lib::web_abi {WebAbi, WebImport}
use lib::glue {Glue.loader}

#[test]
def test_default_loader_has_generated_header : Bool :=
  String.starts_with "// generated by web_wasm from WebAbi -- do not edit"
    (Glue.loader WebAbi.default)

#[test]
def test_default_loader_exports_start : Bool :=
  String.ends_with (Glue.loader WebAbi.default) "export { start };\n"

#[test]
def test_small_abi_golden : Bool :=
  let imp : WebImport :=
    { module := "monad", name := "dom_create", params := ["i64", "i64"], result := "i64" } in
  let abi : WebAbi := { imports := [imp], exports := [] } in
  String.beq (Glue.loader abi)
    "// generated by web_wasm from WebAbi -- do not edit\nimport { host } from \"./web_runtime.js\";\n\nlet imports = {\"monad\": {\"dom_create\": (...args) => host.dom_create(...args)}};\nexport { imports };\nlet start = async (url, selector) => { host.set_root(selector); let mod; try { mod = await WebAssembly.compileStreaming(fetch(url)); } catch (e) { mod = await WebAssembly.compile(await (await fetch(url)).arrayBuffer()); } const instance = await WebAssembly.instantiate(mod, imports); host.bind(instance); if (instance.exports.oak_mount) instance.exports.oak_mount(); host.start_ticks(instance); return instance; };\nexport { start };\n"

/// Imports are grouped by their declared module, not hard-coded under
/// `"monad"`.
#[test]
def test_loader_groups_by_module : Bool :=
  let a : WebImport :=
    { module := "monad", name := "dom_create", params := ["i64"], result := "i64" } in
  let b : WebImport :=
    { module := "env", name := "abort", params := ["i64"], result := "void" } in
  let abi : WebAbi := { imports := [a, b], exports := [] } in
  String.beq (Glue.loader abi)
    "// generated by web_wasm from WebAbi -- do not edit\nimport { host } from \"./web_runtime.js\";\n\nlet imports = {\"monad\": {\"dom_create\": (...args) => host.dom_create(...args)}, \"env\": {\"abort\": (...args) => host.abort(...args)}};\nexport { imports };\nlet start = async (url, selector) => { host.set_root(selector); let mod; try { mod = await WebAssembly.compileStreaming(fetch(url)); } catch (e) { mod = await WebAssembly.compile(await (await fetch(url)).arrayBuffer()); } const instance = await WebAssembly.instantiate(mod, imports); host.bind(instance); if (instance.exports.oak_mount) instance.exports.oak_mount(); host.start_ticks(instance); return instance; };\nexport { start };\n"

// `wasm/web/web.js` is a BUILD ARTIFACT now (`scripts/gen-web-js.sh` builds
// and runs `examples/gen_web_js.mo`), so there is no committed copy to
// drift from. The renderer's contract is pinned by the goldens above; the
// end-to-end check that the generated glue actually instantiates a module
// is `scripts/check-wasm-target.sh`.
