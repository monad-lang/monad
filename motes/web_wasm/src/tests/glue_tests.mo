/// Glue generator tests. These are pure: they never call a web extern, so
/// they run on the Rust host and on every target.

use lib::web_abi {WebAbi, WebImport}
use lib::glue {Glue.loader}

#[test]
def test_default_loader_has_generated_header : Bool :=
  String.starts_with "// generated by web_wasm from WebAbi -- do not edit"
    (Glue.loader WebAbi.default)

#[test]
def test_default_loader_exports_start : Bool :=
  String.ends_with (Glue.loader WebAbi.default) "export { start };\n"

#[test]
def test_small_abi_golden : Bool :=
  let imp : WebImport :=
    { module := "monad", name := "dom_create", params := ["i64", "i64"], result := "i64" } in
  let abi : WebAbi := { imports := [imp], exports := [] } in
  String.beq (Glue.loader abi)
    "// generated by web_wasm from WebAbi -- do not edit\nimport { host } from \"./web_runtime.js\";\n\nlet imports = {\"monad\": {\"dom_create\": (...args) => host.dom_create(...args)}};\nexport { imports };\nlet start = async (url, selector) => { host.set_root(selector); const { instance } = await WebAssembly.instantiateStreaming(fetch(url), imports); host.bind(instance); if (instance.exports.oak_mount) instance.exports.oak_mount(); host.start_ticks(instance); return instance; };\nexport { start };\n"

/// Imports are grouped by their declared module, not hard-coded under
/// `"monad"`.
#[test]
def test_loader_groups_by_module : Bool :=
  let a : WebImport :=
    { module := "monad", name := "dom_create", params := ["i64"], result := "i64" } in
  let b : WebImport :=
    { module := "env", name := "abort", params := ["i64"], result := "void" } in
  let abi : WebAbi := { imports := [a, b], exports := [] } in
  String.beq (Glue.loader abi)
    "// generated by web_wasm from WebAbi -- do not edit\nimport { host } from \"./web_runtime.js\";\n\nlet imports = {\"monad\": {\"dom_create\": (...args) => host.dom_create(...args)}, \"env\": {\"abort\": (...args) => host.abort(...args)}};\nexport { imports };\nlet start = async (url, selector) => { host.set_root(selector); const { instance } = await WebAssembly.instantiateStreaming(fetch(url), imports); host.bind(instance); if (instance.exports.oak_mount) instance.exports.oak_mount(); host.start_ticks(instance); return instance; };\nexport { start };\n"

/// The committed loader must be exactly what the generator renders.
///
/// `wasm/web/web.js` is what the page imports; `examples/gen_web_js.mo`
/// writes it from `Glue.loader WebAbi.default` and `examples/gen_web_js.mo`
/// is the only intended author. Reading it back here means a hand edit, an
/// ABI change without regeneration, or a stale committed file all fail the
/// suite (the file is initialised from this golden once and never edited).
/// Runs from the repository root, which is where both `monad test` and the
/// Rust host run tests.
#[test]
def test_committed_loader_matches_generator : IO Bool := do {
  let r <- IO.read_file (Path.path "wasm/web/web.js");
  match r {
    Result.err _ => return false,
    Result.ok text => return (String.beq text (Glue.loader WebAbi.default))
  }
}
