/// Glue generator tests. These are pure: they never call a web extern, so
/// they run on the Rust host and on every target.

use lib::web_abi {WebAbi, WebImport}
use lib::glue {Glue.loader}

#[test]
def test_default_loader_has_generated_header : Bool :=
  String.starts_with "// generated by web_wasm from WebAbi -- do not edit"
    (Glue.loader WebAbi.default)

#[test]
def test_default_loader_exports_start : Bool :=
  String.ends_with (Glue.loader WebAbi.default) "export { start };\n"

#[test]
def test_small_abi_golden : Bool :=
  let imp : WebImport :=
    { module := "monad", name := "dom_create", params := ["i64", "i64"], result := "i64" } in
  let abi : WebAbi := { imports := [imp], exports := [] } in
  String.beq (Glue.loader abi)
    "// generated by web_wasm from WebAbi -- do not edit\nimport { host } from \"./web_runtime.js\";\n\nlet imports = {\"monad\": {\"dom_create\": (...args) => host.dom_create(...args)}};\nexport { imports };\nlet start = async (url, selector) => { const { instance } = await WebAssembly.instantiateStreaming(fetch(url), imports); if (instance.exports.oak_mount) instance.exports.oak_mount(selector); return instance; };\nexport { start };\n"

/// Imports are grouped by their declared module, not hard-coded under
/// `"monad"`.
#[test]
def test_loader_groups_by_module : Bool :=
  let a : WebImport :=
    { module := "monad", name := "dom_create", params := ["i64"], result := "i64" } in
  let b : WebImport :=
    { module := "env", name := "abort", params := ["i64"], result := "void" } in
  let abi : WebAbi := { imports := [a, b], exports := [] } in
  String.beq (Glue.loader abi)
    "// generated by web_wasm from WebAbi -- do not edit\nimport { host } from \"./web_runtime.js\";\n\nlet imports = {\"monad\": {\"dom_create\": (...args) => host.dom_create(...args)}, \"env\": {\"abort\": (...args) => host.abort(...args)}};\nexport { imports };\nlet start = async (url, selector) => { const { instance } = await WebAssembly.instantiateStreaming(fetch(url), imports); if (instance.exports.oak_mount) instance.exports.oak_mount(selector); return instance; };\nexport { start };\n"

/// The default ABI's loader golden: pins every import name and its order.
/// The C runtime declarations cannot be reflected on from Monad, so this
/// golden plus review is the drift guard for the generated side.
#[test]
def test_default_loader_golden : Bool :=
  String.beq (Glue.loader WebAbi.default)
    "// generated by web_wasm from WebAbi -- do not edit\nimport { host } from \"./web_runtime.js\";\n\nlet imports = {\"monad\": {\"dom_create\": (...args) => host.dom_create(...args), \"dom_create_text\": (...args) => host.dom_create_text(...args), \"dom_root\": (...args) => host.dom_root(...args), \"dom_append\": (...args) => host.dom_append(...args), \"dom_insert_before\": (...args) => host.dom_insert_before(...args), \"dom_remove\": (...args) => host.dom_remove(...args), \"dom_replace\": (...args) => host.dom_replace(...args), \"dom_set_attr\": (...args) => host.dom_set_attr(...args), \"dom_remove_attr\": (...args) => host.dom_remove_attr(...args), \"dom_set_text\": (...args) => host.dom_set_text(...args), \"dom_add_listener\": (...args) => host.dom_add_listener(...args), \"fetch_begin\": (...args) => host.fetch_begin(...args), \"fetch_poll\": (...args) => host.fetch_poll(...args), \"fetch_status\": (...args) => host.fetch_status(...args), \"fetch_read\": (...args) => host.fetch_read(...args), \"now_ms\": (...args) => host.now_ms(...args), \"storage_get_raw\": (...args) => host.storage_get_raw(...args), \"storage_set\": (...args) => host.storage_set(...args), \"console_log\": (...args) => host.console_log(...args)}};\nexport { imports };\nlet start = async (url, selector) => { const { instance } = await WebAssembly.instantiateStreaming(fetch(url), imports); if (instance.exports.oak_mount) instance.exports.oak_mount(selector); return instance; };\nexport { start };\n"
