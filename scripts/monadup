#!/usr/bin/env bash
#
# monadup bootstrap stub.
#
# The real tool is the Monad-written `monadup` binary published as
# `monadup-<platform>` in every nightly release. This script's only job is
# to fetch that binary once and hand over:
#
#   * with arguments: fetch the latest asset and exec it with those args;
#   * with no arguments (the `curl … | bash` one-liner): install the asset
#     into $MONAD_HOME/bin/monadup and print the PATH line / next command.
#
# It is pipe-safe: it never reads stdin, and it never copies "$0" (there is
# no file by that name under `curl | bash`).
#
# Environment:
#   MONAD_HOME       installation root (default: $HOME/.monad)
#   MONADUP_API_URL  releases API base (a `file://` fixture works)
#   MONADUP_UNAME    the `<system> <machine>` pair `uname -sm` would print
#
# jq or python3 is needed for this BOOTSTRAP hop only; the installed binary
# parses JSON in-language. When a release publishes `<asset>.sha256`, the
# downloaded asset is verified with sha256sum or shasum.
set -euo pipefail

REPO="monad-lang/monad"
API_URL="${MONADUP_API_URL:-https://api.github.com/repos/${REPO}/releases}"
FALLBACK_PLATFORM="x86_64-linux"
UNAME_SM="${MONADUP_UNAME:-$(uname -sm)}"

case "$UNAME_SM" in
  "Darwin arm64" | "Darwin aarch64") PLATFORM="aarch64-darwin" ;;
  "Linux aarch64" | "Linux arm64") PLATFORM="aarch64-linux" ;;
  "Linux riscv64") PLATFORM="riscv64-linux" ;;
  "Linux x86_64" | "Linux amd64") PLATFORM="x86_64-linux" ;;
  *)
    PLATFORM="$FALLBACK_PLATFORM"
    echo "monadup: note: no nightly is published for '${UNAME_SM}'; installing the ${FALLBACK_PLATFORM} artifacts" >&2
    ;;
esac

die() { echo "monadup: error: $*" >&2; exit 1; }

up_asset() { echo "monadup-$1"; }

json_ok() {
  command -v jq >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1 \
    || die "neither jq nor python3 is available (needed by the bootstrap stub)"
}

# Verify a downloaded asset against the `<url>.sha256` published beside it.
# Older tags publish none, in which case there is nothing to check. A
# published checksum that cannot be verified is an error, not a pass.
verify_download() {
  local url="$1" file="$2" sums expected actual
  sums="$(curl -fsSL "${url}.sha256" 2>/dev/null)" || return 0
  expected="${sums%%[[:space:]]*}"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$file")"
  elif command -v shasum >/dev/null 2>&1; then
    actual="$(shasum -a 256 "$file")"
  else
    rm -f "$file"
    die "neither sha256sum nor shasum is available to verify ${url}"
  fi
  actual="${actual%%[[:space:]]*}"
  if [ "$actual" != "$expected" ]; then
    rm -f "$file"
    die "checksum mismatch for ${url}"
  fi
}

json_asset_url() {
  local json="$1" tag="$2" name="$3"
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg t "$tag" --arg n "$name" '
      (if type == "array" then (.[] | select(.tag_name == $t)) else . end)
      | .assets[] | select(.name == $n) | .browser_download_url' <<< "$json"
  else
    python3 -c "
import json, sys
tag, name = sys.argv[1], sys.argv[2]
data = json.load(sys.stdin)
if isinstance(data, list):
    data = next((r for r in data if r['tag_name'] == tag), {})
for a in data.get('assets', []):
    if a['name'] == name:
        print(a['browser_download_url'])
" "$tag" "$name" <<< "$json"
  fi
}

json_latest_tag() {
  local json="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -r '[.[] | select(.tag_name | startswith("nightly-"))][0].tag_name // empty' <<< "$json"
  else
    python3 -c "
import json, sys
for r in json.load(sys.stdin):
    if r['tag_name'].startswith('nightly-'):
        print(r['tag_name']); break
" <<< "$json"
  fi
}

json_ok
json="$(curl -fsSL "$API_URL")" || die "failed to query the releases API (network or rate limit)"
tag="$(json_latest_tag "$json")"
[[ -n "$tag" ]] || die "no nightly release found"

asset_url=""
asset_platform=""
for p in "$PLATFORM" "$FALLBACK_PLATFORM"; do
  u="$(json_asset_url "$json" "$tag" "$(up_asset "$p")")"
  if [[ -n "$u" ]]; then
    asset_url="$u"
    asset_platform="$p"
    break
  fi
done
[[ -n "$asset_url" ]] \
  || die "release '${tag}' has no $(up_asset "$PLATFORM") asset and no $(up_asset "$FALLBACK_PLATFORM") one either; build monadup from source or use a tag that ships it"
if [[ "$asset_platform" != "$PLATFORM" ]]; then
  echo "monadup: note: ${tag} ships no $(up_asset "$PLATFORM"); installing the $(up_asset "$asset_platform") one" >&2
fi

home="${MONAD_HOME:-$HOME/.monad}"
bin="$home/bin/monadup"
mkdir -p "$home/bin"

# No arguments: install the binary and tell the user what to run next.
if [[ $# -eq 0 ]]; then
  tmp="$(mktemp "${bin}.tmp.XXXXXX")"
  curl -fsSL -o "$tmp" "$asset_url" || { rm -f "$tmp"; die "failed to download $(up_asset "$asset_platform")"; }
  verify_download "$asset_url" "$tmp"
  chmod +x "$tmp"
  mv -f "$tmp" "$bin"
  echo "monadup: installed $bin"
  echo "Add ${home}/bin to your PATH:"
  echo "  export PATH=\"${home}/bin:\$PATH\""
  echo "Then install a nightly:"
  echo "  monadup default"
  exit 0
fi

# With arguments: exec the fetched binary. `mktemp` matters here -- a
# predictable name in /tmp is a symlink target, and `curl -o` follows
# symlinks. The binary is told its own path (MONADUP_SELF_BIN) so
# `self-install` can copy it on platforms without procfs, and removes it
# once the command returns.
tmp="$(mktemp "${TMPDIR:-/tmp}/monadup-bin.XXXXXX")"
curl -fsSL -o "$tmp" "$asset_url" || { rm -f "$tmp"; die "failed to download $(up_asset "$asset_platform")"; }
verify_download "$asset_url" "$tmp"
chmod +x "$tmp"
MONADUP_SELF_BIN="$tmp" exec "$tmp" "$@"
